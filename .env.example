# --- Supabase (free tier) ---
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → API → service_role key. NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (free tier) ---
# Get a free key at https://aistudio.google.com/apikey — no credit card required
GEMINI_API_KEY=
# Optional overrides — defaults shown are the free-tier-friendliest models
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Google Calendar (Phase 2, free) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Enable the "Google Calendar API" first. Add the redirect URI below as an
# authorized redirect URI on that OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/callback

# --- App ---
# Used to build the embed snippet shown in Settings. Set this to your
# deployed Vercel URL (or custom domain) once deployed.
NEXT_PUBLIC_APP_URL=http://localhost:3000
