        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"text\": $json[\"text\"] } }}",
        "options": {}
      },
      "id": "slack_notify",
      "name": "Notify Owner on Slack (urgent)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [700, 300]
    }
