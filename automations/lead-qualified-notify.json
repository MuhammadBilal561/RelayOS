{
  "name": "RelayOS — Lead Qualified Notify",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "relay-lead-qualified",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook_trigger",
      "name": "RelayOS Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 300],
      "webhookId": "relay-lead-qualified"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "slack_text",
              "name": "text",
              "type": "string",
              "value": "=🆕 New qualified lead for {{$json[\"business_id\"]}}: {{$json[\"payload\"][\"email\"] || $json[\"payload\"][\"phone\"] || \"contact captured\"}} — service interest: {{$json[\"payload\"][\"service_interest\"] || \"not specified\"}}"
            }
          ]
        },
        "options": {}
      },
      "id": "format_message",
      "name": "Format Slack Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/REPLACE/WITH/YOUR_SLACK_WEBHOOK",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"text\": $json[\"text\"] } }}",
        "options": {}
      },
      "id": "slack_notify",
      "name": "Notify Owner on Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [700, 300]
    }
  ],
  "connections": {
    "RelayOS Webhook": {
      "main": [[{ "node": "Format Slack Message", "type": "main", "index": 0 }]]
    },
    "Format Slack Message": {
      "main": [[{ "node": "Notify Owner on Slack", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
